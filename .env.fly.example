# =====================================================================
# Fly.io Secrets for cash-book-api
# Set with: flyctl secrets set -a cash-book-api KEY=value ...
# =====================================================================

# MongoDB Atlas connection string (get from atlas.mongodb.com)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/cashflow?retryWrites=true&w=majority

# JWT — generate strong random values
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS — frontend Fly URL
CLIENT_URL=https://cash-book-web.fly.dev

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# OAuth — optional (skip if not using Google/GitHub login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://cash-book-api.fly.dev/api/auth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://cash-book-api.fly.dev/api/auth/github/callback
