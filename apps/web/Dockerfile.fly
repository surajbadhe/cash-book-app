# Build stage — same as Dockerfile but uses production Fly nginx config
FROM node:20-alpine AS builder

RUN npm install -g pnpm

WORKDIR /app

COPY package*.json pnpm-lock.yaml* ./
COPY apps/web/package*.json ./apps/web/

RUN pnpm install --frozen-lockfile

COPY apps/web ./apps/web
COPY tsconfig.json ./

WORKDIR /app/apps/web
RUN pnpm run build:prod

# Production stage with nginx
FROM nginx:alpine

# Copy built Angular app
COPY --from=builder /app/apps/web/dist/web /usr/share/nginx/html

# Copy Fly-specific nginx config (proxies /api/ to cash-book-api.fly.dev)
COPY apps/web/nginx.fly.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
